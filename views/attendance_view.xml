<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="attendance_form_view" model="ir.ui.view">
            <field name="name">course_center.attendance.form</field>
            <field name="model">course_center.attendance</field>
            <field name="arch" type="xml">
                <form string="Attendance">
                    <sheet>
                        <div class="oe_title">
                            <label for="enrollment_id"/>
                            <h1>
                                <field name="enrollment_id" placeholder="Enrollment"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="session_id"/>
                                <field name="status"/>
                            </group>

                            <group>
                                <field name="notes"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="attendance_tree_view" model="ir.ui.view">
            <field name="name">course_center.attendance.tree</field>
            <field name="model">course_center.attendance</field>
            <field name="arch" type="xml">
                <tree string="Attendance">
                    <field name="enrollment_id"/>
                    <field name="session_id"/>
                    <field name="status"/>
                    <field name="notes"/>
                </tree>
            </field>
        </record>

        <record id="attendance_search_view" model="ir.ui.view">
            <field name="name">course_center.attendance.search</field>
            <field name="model">course_center.attendance</field>
            <field name="arch" type="xml">
                <search string="Attendance">
                    <field name="enrollment_id"/>
                    <field name="session_id"/>
                    <field name="status"/>
                </search>
            </field>
        </record>

        <record id="attendance_act_window" model="ir.actions.act_window">
            <field name="name">Attendance</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">course_center.attendance</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There are no attendance records. Click here to add attendance.
                </p>
            </field>
        </record>

    </data>
</odoo>
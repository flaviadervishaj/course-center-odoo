<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="course_category_tree_view" model="ir.ui.view">
            <field name="name">course_center.category.tree</field>
            <field name="model">course_center.category</field>
            <field name="arch" type="xml">
                <tree string="Course Category" editable="top">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>

        <record id="course_category_search_view" model="ir.ui.view">
            <field name="name">course_center.category.search</field>
            <field name="model">course_center.category</field>
            <field name="arch" type="xml">
                <search string="Course Category">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="status"/>
                </search>
            </field>
        </record>

        <record id="course_category_act_window" model="ir.actions.act_window">
            <field name="name">Course Categories</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">course_center.category</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There are no course categories. Click here to add a new category.
                </p>
            </field>
        </record>

    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="course_center_res_users_form_view" model="ir.ui.view">
            <field name="name">course.center.res.users.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">

                <xpath expr="//notebook" position="inside">

                    <page string="Course Center" name="course_center">

                        <group>
                            <group>
                                <field name="login"/>
                                <field name="email"/>
                                <field name="phone"/>
                            </group>

                            <group>
                                <field name="course_center_role"/>
                                <field name="active"/>
                                <field name="create_date" readonly="1"/>
                            </group>
                        </group>

                    </page>

                </xpath>

            </field>
        </record>

    </data>
</odoo>
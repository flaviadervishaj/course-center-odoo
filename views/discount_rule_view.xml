<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="discount_rule_tree_view" model="ir.ui.view">
            <field name="name">course_center.discount_rule.tree</field>
            <field name="model">course_center.discount_rule</field>
            <field name="arch" type="xml">
                <tree string="Discount Rule" editable="top">
                    <field name="course_number"/>
                    <field name="discount_percentage"/>
                    <field name="description"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>

        <record id="discount_rule_search_view" model="ir.ui.view">
            <field name="name">course_center.discount_rule.search</field>
            <field name="model">course_center.discount_rule</field>
            <field name="arch" type="xml">
                <search string="Discount Rule">
                    <field name="course_number"/>
                    <field name="discount_percentage"/>
                    <field name="status"/>
                </search>
            </field>
        </record>

        <record id="discount_rule_act_window" model="ir.actions.act_window">
            <field name="name">Discount Rules</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">course_center.discount_rule</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There are no discount rules. Click here to add a new rule.
                </p>
            </field>
        </record>

    </data>
</odoo>
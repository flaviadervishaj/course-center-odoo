<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="room_tree_view" model="ir.ui.view">
            <field name="name">course_center.room.tree</field>
            <field name="model">course_center.room</field>
            <field name="arch" type="xml">
                <tree string="Room" editable="top">
                    <field name="name"/>
                    <field name="capacity"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>

        <record id="room_search_view" model="ir.ui.view">
            <field name="name">course_center.room.search</field>
            <field name="model">course_center.room</field>
            <field name="arch" type="xml">
                <search string="Room">
                    <field name="name"/>
                    <field name="capacity"/>
                    <field name="status"/>
                </search>
            </field>
        </record>

        <record id="room_act_window" model="ir.actions.act_window">
            <field name="name">Rooms</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">course_center.room</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There are no rooms. Click here to add a new room.
                </p>
            </field>
        </record>

    </data>
</odoo>
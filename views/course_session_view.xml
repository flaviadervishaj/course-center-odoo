<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="course_session_form_view" model="ir.ui.view">
            <field name="name">course_center.session.form</field>
            <field name="model">course_center.session</field>
            <field name="arch" type="xml">
                <form string="Course Session">
                    <sheet>
                        <div class="oe_title">
                            <label for="topic"/>
                            <h1>
                                <field name="topic" placeholder="Session Topic"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="group_id"/>
                                <field name="room_id"/>
                                <field name="session_date"/>
                            </group>

                            <group>
                                <field name="start_time"/>
                                <field name="end_time"/>
                                <field name="status"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="course_session_tree_view" model="ir.ui.view">
            <field name="name">course_center.session.tree</field>
            <field name="model">course_center.session</field>
            <field name="arch" type="xml">
                <tree string="Course Session">
                    <field name="topic"/>
                    <field name="group_id"/>
                    <field name="room_id"/>
                    <field name="session_date"/>
                    <field name="start_time"/>
                    <field name="end_time"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>

        <record id="course_session_search_view" model="ir.ui.view">
            <field name="name">course_center.session.search</field>
            <field name="model">course_center.session</field>
            <field name="arch" type="xml">
                <search string="Course Session">
                    <field name="topic"/>
                    <field name="group_id"/>
                    <field name="room_id"/>
                    <field name="session_date"/>
                    <field name="status"/>
                </search>
            </field>
        </record>

        <record id="course_session_act_window" model="ir.actions.act_window">
            <field name="name">Course Sessions</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">course_center.session</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There are no course sessions. Click here to add a new session.
                </p>
            </field>
        </record>

    </data>
</odoo>
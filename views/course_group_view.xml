<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="course_group_form_view" model="ir.ui.view">
            <field name="name">course_center.group.form</field>
            <field name="model">course_center.group</field>
            <field name="arch" type="xml">
                <form string="Course Group">
                    <sheet>
                        <div class="oe_title">
                            <label for="group_name"/>
                            <h1>
                                <field name="group_name" placeholder="Group Name"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="course_id"/>
                                <field name="instructor_id"/>
                                <field name="capacity"/>
                            </group>

                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="status"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="course_group_tree_view" model="ir.ui.view">
            <field name="name">course_center.group.tree</field>
            <field name="model">course_center.group</field>
            <field name="arch" type="xml">
                <tree string="Course Group">
                    <field name="group_name"/>
                    <field name="course_id"/>
                    <field name="instructor_id"/>
                    <field name="capacity"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>

        <record id="course_group_search_view" model="ir.ui.view">
            <field name="name">course_center.group.search</field>
            <field name="model">course_center.group</field>
            <field name="arch" type="xml">
                <search string="Course Group">
                    <field name="group_name"/>
                    <field name="course_id"/>
                    <field name="instructor_id"/>
                    <field name="status"/>
                </search>
            </field>
        </record>

        <record id="course_group_act_window" model="ir.actions.act_window">
            <field name="name">Course Groups</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">course_center.group</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There are no course groups. Click here to add a new group.
                </p>
            </field>
        </record>

    </data>
</odoo>
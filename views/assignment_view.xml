<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="assignment_form_view" model="ir.ui.view">
            <field name="name">course_center.assignment.form</field>
            <field name="model">course_center.assignment</field>
            <field name="arch" type="xml">
                <form string="Assignment">
                    <sheet>
                        <div class="oe_title">
                            <label for="title"/>
                            <h1>
                                <field name="title" placeholder="Assignment Title"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="group_id"/>
                                <field name="type"/>
                                <field name="status"/>
                            </group>

                            <group>
                                <field name="publish_date"/>
                                <field name="deadline"/>
                                <field name="created_at"/>
                            </group>
                        </group>

                        <group>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="assignment_tree_view" model="ir.ui.view">
            <field name="name">course_center.assignment.tree</field>
            <field name="model">course_center.assignment</field>
            <field name="arch" type="xml">
                <tree string="Assignment">
                    <field name="title"/>
                    <field name="group_id"/>
                    <field name="type"/>
                    <field name="publish_date"/>
                    <field name="deadline"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>

        <record id="assignment_search_view" model="ir.ui.view">
            <field name="name">course_center.assignment.search</field>
            <field name="model">course_center.assignment</field>
            <field name="arch" type="xml">
                <search string="Assignment">
                    <field name="title"/>
                    <field name="group_id"/>
                    <field name="type"/>
                    <field name="deadline"/>
                    <field name="status"/>
                </search>
            </field>
        </record>

        <record id="assignment_act_window" model="ir.actions.act_window">
            <field name="name">Assignments</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">course_center.assignment</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There are no assignments. Click here to add a new assignment.
                </p>
            </field>
        </record>

    </data>
</odoo>
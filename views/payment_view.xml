<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="payment_form_view" model="ir.ui.view">
            <field name="name">course_center.payment.form</field>
            <field name="model">course_center.payment</field>
            <field name="arch" type="xml">
                <form string="Payment">
                    <sheet>
                        <div class="oe_title">
                            <label for="invoice_id"/>
                            <h1>
                                <field name="invoice_id" placeholder="Invoice"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="payment_date"/>
                                <field name="amount"/>
                            </group>

                            <group>
                                <field name="payment_method"/>
                                <field name="status"/>
                            </group>
                        </group>

                        <group>
                            <field name="notes"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="payment_tree_view" model="ir.ui.view">
            <field name="name">course_center.payment.tree</field>
            <field name="model">course_center.payment</field>
            <field name="arch" type="xml">
                <tree string="Payment">
                    <field name="invoice_id"/>
                    <field name="payment_date"/>
                    <field name="amount"/>
                    <field name="payment_method"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>

        <record id="payment_search_view" model="ir.ui.view">
            <field name="name">course_center.payment.search</field>
            <field name="model">course_center.payment</field>
            <field name="arch" type="xml">
                <search string="Payment">
                    <field name="invoice_id"/>
                    <field name="payment_date"/>
                    <field name="payment_method"/>
                    <field name="status"/>
                </search>
            </field>
        </record>

        <record id="payment_act_window" model="ir.actions.act_window">
            <field name="name">Payments</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">course_center.payment</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There are no payments. Click here to add a new payment.
                </p>
            </field>
        </record>

    </data>
</odoo>